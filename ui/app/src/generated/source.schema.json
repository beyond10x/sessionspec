{
  "$defs": {
    "agenticspec.cli.AgentScope": {
      "enum": [
        "main",
        "sub"
      ],
      "title": "AgentScope",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "agenticspec.cli.AgentScope"
    },
    "agenticspec.cli.AutonomyFigures": {
      "additionalProperties": false,
      "description": "Prompts and decisions of main agents. Working is time in which at least one agent of the session was Working (gaps up to 10 minutes). Waiting on the human is time in which no agent was Working, from a main agent's turn end to its next Human or Delegate prompt; over one hour it counts as away.",
      "properties": {
        "away_seconds": {
          "type": "integer"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/agenticspec.cli.DecisionFigures"
          },
          "type": "array"
        },
        "prompts": {
          "items": {
            "$ref": "#/$defs/agenticspec.cli.PromptFigures"
          },
          "type": "array"
        },
        "waiting_on_human_seconds": {
          "type": "integer"
        },
        "working_seconds": {
          "type": "integer"
        }
      },
      "required": [
        "working_seconds",
        "waiting_on_human_seconds",
        "away_seconds",
        "prompts",
        "decisions"
      ],
      "title": "AutonomyFigures",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "agenticspec.cli.AutonomyFigures"
    },
    "agenticspec.cli.BustCause": {
      "enum": [
        "ttl_expired",
        "model_changed",
        "compacted",
        "unexplained"
      ],
      "title": "BustCause",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "agenticspec.cli.BustCause"
    },
    "agenticspec.cli.BustFigures": {
      "additionalProperties": false,
      "properties": {
        "cause": {
          "$ref": "#/$defs/agenticspec.cli.BustCause"
        },
        "count": {
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/agenticspec.cli.AgentScope"
        },
        "tokens_written_again": {
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "cause",
        "count",
        "tokens_written_again"
      ],
      "title": "BustFigures",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "agenticspec.cli.BustFigures"
    },
    "agenticspec.cli.CacheFigures": {
      "additionalProperties": false,
      "properties": {
        "hit_permille": {
          "type": "integer"
        },
        "read_tokens": {
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/agenticspec.cli.AgentScope"
        },
        "uncached_tokens": {
          "type": "integer"
        },
        "write_tokens": {
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "read_tokens",
        "write_tokens",
        "uncached_tokens",
        "hit_permille"
      ],
      "title": "CacheFigures",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "agenticspec.cli.CacheFigures"
    },
    "agenticspec.cli.ConcurrencyFigures": {
      "additionalProperties": false,
      "description": "Agents active in the same minute; active means two of its records at most 5 minutes apart around the minute.",
      "properties": {
        "max": {
          "type": "integer"
        },
        "p50": {
          "type": "integer"
        },
        "p90": {
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/agenticspec.cli.AgentScope"
        }
      },
      "required": [
        "scope",
        "p50",
        "p90",
        "max"
      ],
      "title": "ConcurrencyFigures",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "agenticspec.cli.ConcurrencyFigures"
    },
    "agenticspec.cli.DecisionFigures": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer"
        },
        "decider": {
          "$ref": "#/$defs/agenticspec.session.Decider"
        },
        "decision": {
          "$ref": "#/$defs/agenticspec.session.Decision"
        }
      },
      "required": [
        "decider",
        "decision",
        "count"
      ],
      "title": "DecisionFigures",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "agenticspec.cli.DecisionFigures"
    },
    "agenticspec.cli.ExposureFigures": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "$ref": "#/$defs/agenticspec.session.ExposureChannel"
        },
        "class": {
          "$ref": "#/$defs/agenticspec.session.ExposureClass"
        },
        "count": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "sessions": {
          "type": "integer"
        },
        "verdict": {
          "$ref": "#/$defs/agenticspec.session.Verdict"
        }
      },
      "required": [
        "channel",
        "class",
        "kind",
        "verdict",
        "count",
        "sessions"
      ],
      "title": "ExposureFigures",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "agenticspec.cli.ExposureFigures"
    },
    "agenticspec.cli.KpiReport": {
      "additionalProperties": false,
      "properties": {
        "autonomy": {
          "$ref": "#/$defs/agenticspec.cli.AutonomyFigures"
        },
        "busts": {
          "items": {
            "$ref": "#/$defs/agenticspec.cli.BustFigures"
          },
          "type": "array"
        },
        "cache": {
          "items": {
            "$ref": "#/$defs/agenticspec.cli.CacheFigures"
          },
          "type": "array"
        },
        "concurrency": {
          "items": {
            "$ref": "#/$defs/agenticspec.cli.ConcurrencyFigures"
          },
          "type": "array"
        },
        "cost_microdollars": {
          "description": "The sum of the model figures, at API list price; a subscription bills otherwise.",
          "type": "integer"
        },
        "exposures": {
          "items": {
            "$ref": "#/$defs/agenticspec.cli.ExposureFigures"
          },
          "type": "array"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/agenticspec.cli.ModelFigures"
          },
          "type": "array"
        },
        "refused_commands": {
          "type": "integer"
        },
        "sessions": {
          "type": "integer"
        },
        "sub_agents": {
          "type": "integer"
        },
        "transcripts": {
          "type": "integer"
        },
        "unpriced_messages": {
          "description": "Model messages of a model with no price in src/pricing.rs, not in the cost.",
          "type": "integer"
        },
        "window_from": {
          "type": "string"
        },
        "window_to": {
          "type": "string"
        }
      },
      "required": [
        "window_from",
        "window_to",
        "transcripts",
        "sessions",
        "sub_agents",
        "refused_commands",
        "cost_microdollars",
        "unpriced_messages",
        "models",
        "cache",
        "busts",
        "concurrency",
        "autonomy",
        "exposures"
      ],
      "title": "KpiReport",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "agenticspec.cli.KpiReport"
    },
    "agenticspec.cli.ModelFigures": {
      "additionalProperties": false,
      "properties": {
        "context_max": {
          "type": "integer"
        },
        "context_p50": {
          "type": "integer"
        },
        "context_p90": {
          "type": "integer"
        },
        "cost_microdollars": {
          "description": "The tokens of these messages at the API list price of the model (src/pricing.rs), in millionths of a dollar; 0 for a model with no price.",
          "type": "integer"
        },
        "messages": {
          "type": "integer"
        },
        "model": {
          "type": "string"
        },
        "output_tokens": {
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/agenticspec.cli.AgentScope"
        }
      },
      "required": [
        "scope",
        "model",
        "messages",
        "output_tokens",
        "context_p50",
        "context_p90",
        "context_max",
        "cost_microdollars"
      ],
      "title": "ModelFigures",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "agenticspec.cli.ModelFigures"
    },
    "agenticspec.cli.PromptFigures": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "$ref": "#/$defs/agenticspec.session.Attribution"
        },
        "author": {
          "$ref": "#/$defs/agenticspec.session.PromptAuthor"
        },
        "count": {
          "type": "integer"
        }
      },
      "required": [
        "author",
        "attribution",
        "count"
      ],
      "title": "PromptFigures",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "agenticspec.cli.PromptFigures"
    },
    "agenticspec.session.AgentId": {
      "description": "One agent loop in a session; the main loop or a sub-agent.",
      "title": "AgentId",
      "type": "string",
      "x-ess-kind": "newtype",
      "x-ess-name": "agenticspec.session.AgentId"
    },
    "agenticspec.session.AgentRole": {
      "description": "SideCall is a model call of the harness outside every agent's conversation (a title, a summary, a quota probe): the wire tells it by a call with no tools and no history.",
      "enum": [
        "Main",
        "SubAgent",
        "SideCall"
      ],
      "title": "AgentRole",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "agenticspec.session.AgentRole"
    },
    "agenticspec.session.Attribution": {
      "description": "How the author was established. Known from a structured field of the transcript, Inferred from a text prefix, Unknown otherwise.",
      "enum": [
        "Known",
        "Inferred",
        "Unknown"
      ],
      "title": "Attribution",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "agenticspec.session.Attribution"
    },
    "agenticspec.session.Decider": {
      "description": "What decided a tool call. NotRecorded where the transcript carries no decision.",
      "enum": [
        "PermissionMode",
        "Classifier",
        "Hook",
        "Human",
        "SafetyCheck",
        "Rule",
        "NotRecorded"
      ],
      "title": "Decider",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "agenticspec.session.Decider"
    },
    "agenticspec.session.Decision": {
      "enum": [
        "Accept",
        "Refuse"
      ],
      "title": "Decision",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "agenticspec.session.Decision"
    },
    "agenticspec.session.ExposureChannel": {
      "description": "Where a secret or a personal datum appeared. ToolInput is the severe one when the tool's category is Network, Message or Execute: the value left the session.",
      "enum": [
        "Prompt",
        "ToolInput",
        "ToolOutput",
        "AgentText"
      ],
      "title": "ExposureChannel",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "agenticspec.session.ExposureChannel"
    },
    "agenticspec.session.ExposureClass": {
      "enum": [
        "Secret",
        "PersonalData"
      ],
      "title": "ExposureClass",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "agenticspec.session.ExposureClass"
    },
    "agenticspec.session.Harness": {
      "enum": [
        "ClaudeCode",
        "Codex",
        "Other"
      ],
      "title": "Harness",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "agenticspec.session.Harness"
    },
    "agenticspec.session.PromptAuthor": {
      "description": "Who wrote a prompt. Delegate is a session acting for the human; Harness covers task notifications, compaction summaries and auto-continuation.",
      "enum": [
        "Human",
        "Delegate",
        "PeerSession",
        "ParentAgent",
        "Harness",
        "Hook"
      ],
      "title": "PromptAuthor",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "agenticspec.session.PromptAuthor"
    },
    "agenticspec.session.SessionId": {
      "description": "The harness's own session identifier.",
      "title": "SessionId",
      "type": "string",
      "x-ess-kind": "newtype",
      "x-ess-name": "agenticspec.session.SessionId"
    },
    "agenticspec.session.Verdict": {
      "description": "Ok is a known fixture or allowed value, Gap a confirmed exposure, Unk a match nobody confirmed.",
      "enum": [
        "Ok",
        "Gap",
        "Unk"
      ],
      "title": "Verdict",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "agenticspec.session.Verdict"
    },
    "agenticspec.view.Agent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "spawned_by": {
          "type": "string"
        },
        "started_at": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "role",
        "started_at"
      ],
      "title": "Agent",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "agenticspec.view.Agent"
    },
    "agenticspec.view.AgentTurns.row": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/agenticspec.session.AgentId"
        },
        "agent_cost_usd": {
          "type": "number"
        },
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "cache_read_tokens": {
          "type": "integer"
        },
        "cache_write_tokens": {
          "type": "integer"
        },
        "call": {
          "type": "string"
        },
        "context_tokens": {
          "type": "integer"
        },
        "cost_microdollars": {
          "type": "integer"
        },
        "detail": {
          "type": "string"
        },
        "event_id": {
          "$ref": "#/$defs/agenticspec.view.EventId"
        },
        "kind": {
          "$ref": "#/$defs/agenticspec.view.EventKind"
        },
        "label": {
          "type": "string"
        },
        "notable": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "ord": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "seq": {
          "type": "integer"
        },
        "session_cost_usd": {
          "type": "number"
        },
        "session_id": {
          "$ref": "#/$defs/agenticspec.session.SessionId"
        }
      },
      "required": [
        "event_id",
        "session_id",
        "seq",
        "ord",
        "at",
        "agent",
        "kind",
        "notable",
        "label",
        "agent_cost_usd",
        "session_cost_usd"
      ],
      "title": "Model turns of an agent row",
      "type": "object",
      "x-ess-kind": "view-row",
      "x-ess-name": "agenticspec.view.AgentTurns"
    },
    "agenticspec.view.AgentUpdated": {
      "additionalProperties": false,
      "description": "An agent started or its figures changed; the payload is its whole row.",
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/agenticspec.session.AgentId"
        },
        "busts": {
          "type": "integer"
        },
        "context_max": {
          "type": "integer"
        },
        "context_tokens": {
          "type": "integer"
        },
        "cost_usd": {
          "type": "number"
        },
        "model": {
          "type": "string"
        },
        "output_tokens": {
          "type": "integer"
        },
        "parent": {
          "$ref": "#/$defs/agenticspec.session.AgentId"
        },
        "role": {
          "$ref": "#/$defs/agenticspec.session.AgentRole"
        },
        "session_id": {
          "$ref": "#/$defs/agenticspec.session.SessionId"
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        },
        "tool_calls": {
          "type": "integer"
        },
        "turns": {
          "type": "integer"
        }
      },
      "required": [
        "agent_id",
        "session_id",
        "role",
        "started_at",
        "turns",
        "context_tokens",
        "context_max",
        "output_tokens",
        "cost_usd",
        "tool_calls",
        "busts"
      ],
      "title": "AgentUpdated",
      "type": "object",
      "x-ess-kind": "event-payload",
      "x-ess-name": "agenticspec.view.AgentUpdated"
    },
    "agenticspec.view.BucketId": {
      "description": "One time bucket of the overview, its start in milliseconds since the epoch.",
      "title": "BucketId",
      "type": "string",
      "x-ess-kind": "newtype",
      "x-ess-name": "agenticspec.view.BucketId"
    },
    "agenticspec.view.CheckId": {
      "description": "One check of one session, `<session_id>.<check>`.",
      "title": "CheckId",
      "type": "string",
      "x-ess-kind": "newtype",
      "x-ess-name": "agenticspec.view.CheckId"
    },
    "agenticspec.view.CountId": {
      "description": "The count of one event kind in one session, `<session_id>.<agent or *>.<kind>`.",
      "title": "CountId",
      "type": "string",
      "x-ess-kind": "newtype",
      "x-ess-name": "agenticspec.view.CountId"
    },
    "agenticspec.view.Document": {
      "additionalProperties": false,
      "description": "One session for a renderer, format `agenticspec-view/1`.",
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/agenticspec.view.Agent"
          },
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/agenticspec.view.Event"
          },
          "type": "array"
        },
        "format": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "format",
        "session_id",
        "project",
        "harness",
        "agents",
        "events"
      ],
      "title": "Document",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "agenticspec.view.Document"
    },
    "agenticspec.view.Event": {
      "additionalProperties": false,
      "description": "One thing that happened, at an instant in milliseconds since the epoch. `label` names it: the tool, the prompt author, the model, the decider, the exposure kind, the bust cause. Numbers that do not apply are absent.",
      "properties": {
        "agent": {
          "type": "string"
        },
        "at": {
          "type": "integer"
        },
        "bytes": {
          "description": "The length of the prompt, the tool input or the tool output.",
          "type": "integer"
        },
        "cache_read_tokens": {
          "type": "integer"
        },
        "cache_write_tokens": {
          "type": "integer"
        },
        "call": {
          "type": "string"
        },
        "context_tokens": {
          "type": "integer"
        },
        "cost_microdollars": {
          "description": "At API list price.",
          "type": "integer"
        },
        "detail": {
          "description": "A second name, by kind - a tool category, a prompt class and attribution, a decision, a channel.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/agenticspec.view.EventKind"
        },
        "label": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "output_tokens": {
          "type": "integer"
        },
        "seq": {
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "at",
        "agent",
        "kind",
        "label"
      ],
      "title": "Event",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "agenticspec.view.Event"
    },
    "agenticspec.view.EventAppended": {
      "additionalProperties": false,
      "description": "One event of a running session; the payload is its row.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/agenticspec.session.AgentId"
        },
        "agent_cost_usd": {
          "type": "number"
        },
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "cache_read_tokens": {
          "type": "integer"
        },
        "cache_write_tokens": {
          "type": "integer"
        },
        "call": {
          "type": "string"
        },
        "context_tokens": {
          "type": "integer"
        },
        "cost_microdollars": {
          "type": "integer"
        },
        "detail": {
          "type": "string"
        },
        "event_id": {
          "$ref": "#/$defs/agenticspec.view.EventId"
        },
        "kind": {
          "$ref": "#/$defs/agenticspec.view.EventKind"
        },
        "label": {
          "type": "string"
        },
        "notable": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "ord": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "seq": {
          "type": "integer"
        },
        "session_cost_usd": {
          "type": "number"
        },
        "session_id": {
          "$ref": "#/$defs/agenticspec.session.SessionId"
        }
      },
      "required": [
        "event_id",
        "session_id",
        "seq",
        "ord",
        "at",
        "agent",
        "kind",
        "notable",
        "label",
        "agent_cost_usd",
        "session_cost_usd"
      ],
      "title": "EventAppended",
      "type": "object",
      "x-ess-kind": "event-payload",
      "x-ess-name": "agenticspec.view.EventAppended"
    },
    "agenticspec.view.EventId": {
      "description": "One view event of one session, `<session_id>.<seq>`; a dot, since a row key is one segment of an ess-ui node path, which `/` separates.",
      "title": "EventId",
      "type": "string",
      "x-ess-kind": "newtype",
      "x-ess-name": "agenticspec.view.EventId"
    },
    "agenticspec.view.EventKind": {
      "enum": [
        "agent_started",
        "prompt",
        "model_turn",
        "tool_call",
        "decision",
        "tool_result",
        "turn_end",
        "compaction",
        "exposure",
        "cache_bust"
